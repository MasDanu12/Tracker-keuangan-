{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracker-keuangan",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tracker_keuangan_db",
      "database_id": "GANTI_DENGAN_DATABASE_ID_KAMU"
    }
  ]
}
